{
  "name": "reiki-timer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run routes:generate && node ./node_modules/typescript/bin/tsc --noEmit && vite build",
    "check": "biome check",
    "check:colors": "bun scripts/check-colors.ts",
    "check:fix": "biome check --write",
    "dev": "vite",
    "format": "biome format --write",
    "lint": "biome lint",
    "preview": "vite preview",
    "routes:generate": "bun run --bun tsr generate",
    "skills:list": "intent list",
    "skills:load": "intent load",
    "skills:validate": "intent validate",
    "test": "vitest run",
    "test:browser": "vitest run --project chromium",
    "test:install": "playwright install chromium",
    "test:tools": "vitest run --project tooling",
    "test:unit": "vitest run --project unit",
    "typecheck": "bun run routes:generate && node ./node_modules/typescript/bin/tsc --noEmit",
    "verify": "bun run check && bun run check:colors && bun run build && bun run test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@paper-design/shaders": "0.0.82",
    "@paper-design/shaders-react": "0.0.82",
    "@tanstack/react-router": "^1.170.46",
    "motion": "14.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.13",
    "@biomejs/biome": "2.6.3",
    "@tanstack/intent": "^0.5.6",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.4",
    "@types/culori": "4.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.1.0",
    "axe-core": "4.14.0",
    "culori": "4.0.2",
    "happy-dom": "^21.0.4",
    "lightningcss": "1.33.0",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.2.17",
  "intent": {
    "skills": [
      "@tanstack/react-router",
      "@tanstack/router-core"
    ]
  }
}
