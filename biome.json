{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css}",
      "!**/bun.lock",
      "!**/package-lock.json",
      "!**/next-env.d.ts",
      "!!**/node_modules",
      "!!**/.next",
      "!!**/.react-router",
      "!!**/dist",
      "!!**/build",
      "!!**/coverage",
      "!!**/generated",
      "!**/routeTree.gen.ts"
    ]
  },
  "formatter": {
    "useEditorconfig": true,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "style": {
        "noHexColors": "error"
      },
      "suspicious": {
        "useBaseline": {
          "level": "error",
          "options": {
            "allowProperties": [
              "backdrop-filter",
              "mask",
              "mask-composite",
              "overflow-anchor",
              "overflow-clip-margin",
              "scrollbar-width",
              "text-wrap",
              "user-select",
              "view-transition-name"
            ],
            "allowMediaConditions": ["prefers-reduced-transparency"],
            "allowSelectors": [
              "active-view-transition",
              "selection",
              "view-transition"
            ],
            "allowPropertyValues": {
              "display": ["contents"]
            }
          }
        }
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "overrides": [
    {
      "includes": ["src/components/design-system/styles/theme.css"],
      "linter": {
        "rules": {
          "style": {
            "noHexColors": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false,
                "conventions": [
                  {
                    "selector": {
                      "kind": "typeProperty"
                    },
                    "formats": ["camelCase"]
                  },
                  {
                    "selector": {
                      "kind": "any"
                    },
                    "match": ".*"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
